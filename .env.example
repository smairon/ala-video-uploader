# Directory shared with the external recorder. Contains only HLS media artifacts.
RECORDINGS_DIR=/recordings

# Uploader-private SQLite state. Do not place it inside RECORDINGS_DIR.
STATE_DB_PATH=/state/uploader.sqlite3

# S3-compatible object storage connection.
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=video
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key

# Worker scheduling and recording lifecycle, in seconds.
POLL_INTERVAL_SECONDS=2
# Upload the current final segment only after its size and mtime remain unchanged for this period.
LAST_SEGMENT_STABLE_SECONDS=4
MAX_RECORDING_SECONDS=36000
PLAYLIST_RETENTION_SECONDS=86400
UPLOAD_CONCURRENCY=8

# Prometheus endpoint exposed by the uploader process.
METRICS_PORT=8000

# Root log level and optional component-specific overrides.
LOG_LEVEL=INFO
LOG_LEVEL_UPLOADER_DAEMON=INFO
LOG_LEVEL_UPLOADER_PUBLISHER=INFO
LOG_LEVEL_UPLOADER_CLEANUP=INFO
LOG_LEVEL_UPLOADER_EMULATOR=INFO
LOG_LEVEL_UPLOADER_S3=INFO
